# Copie para .env (NUNCA versionado) e preencha localmente.
# Base de HOMOLOGAÇÃO Protheus (SQL Server) — acesso SEMPRE read-only
# pela aplicação (pacote protheus-db, seção 32).

# Ambiente atual: SQL Server local (Windows), base P1212510.
PROTHEUS_DB_HOST=127.0.0.1
PROTHEUS_DB_PORT=1433
PROTHEUS_DB_NAME=P1212510
PROTHEUS_DB_USER=
PROTHEUS_DB_PASSWORD=
PROTHEUS_DB_ENCRYPT=false
PROTHEUS_DB_TRUST_SERVER_CERT=true

# Sufixo de empresa das tabelas físicas (ex.: 010 → SB8010).
# Descobrir na base via sys.tables — não presumir.
PROTHEUS_TABLE_SUFFIX=

# Banco PRÓPRIO da aplicação (auditoria, cache, data quality).
# Nunca apontar para o banco do Protheus.
APP_DB_URL=file:./data/app.sqlite

# ERP Protheus (AppServer) — REST, testes TLPP e massa de teste. Só no ambiente de TESTE.
PROTHEUS_REST_URL=https://localhost:8446/rest
PROTHEUS_ERP_USER=
PROTHEUS_ERP_PASSWORD=
PROTHEUS_SYSTEM_DIR=C:/TOTVS/Microsiga/Protheus12125_Data/system
